# Copy this file to .env and fill in the values:   cp .env.example .env
# .env is git-ignored. Never commit it.

# --- Required -------------------------------------------------------------
# Random string that encrypts anything n8n stores. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
# Keep it stable: changing it later makes existing n8n data unreadable.
N8N_ENCRYPTION_KEY=replace-with-a-long-random-string

# SEC EDGAR requires a descriptive User-Agent with a contact email.
# https://www.sec.gov/os/accessing-edgar-data
SEC_USER_AGENT="ResearchReportGenerator your-email@example.com"

# --- LLM (local Ollama by default) ------------------------------------------
# Ollama running on your host machine (Docker Desktop resolves host.docker.internal).
OLLAMA_BASE_URL=http://host.docker.internal:11434
# Any chat model you have pulled: qwen3:4b (better), llama3.2:1b (faster)
LLM_MODEL=qwen3:4b
LLM_NUM_CTX=8192

# --- Optional -------------------------------------------------------------
TIMEZONE=UTC
# Benchmark for relative performance (auto-switches to ^NSEI for .NS/.BO tickers)
DEFAULT_BENCHMARK=SPY
HISTORY_PERIOD=2y

# Host ports (bound to 127.0.0.1 only)
N8N_PORT=5679
SITE_PORT=8088
ANALYTICS_PORT=8010

# Pin a different n8n image if you want (default: n8nio/n8n:2.41.4)
# N8N_IMAGE=n8nio/n8n:2.41.4
